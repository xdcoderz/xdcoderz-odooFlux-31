PORT=8000
TOKEN_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set DATABASE_URL to hosted PostgreSQL in Vercel; local development defaults to SQLite.
DATABASE_URL=
# Vercel production: keep demo seeding disabled and configure the first admin.
SEED_DEMO_DATA=false
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-strong-password
FRONTEND_URL=http://localhost:5173
# Optional until an email provider is configured. Without SMTP, password-reset emails are unavailable.
# Invoice sends are recorded as simulated when SMTP is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=billing@brightloop.example
SMTP_STARTTLS=true
SMTP_SSL=false
