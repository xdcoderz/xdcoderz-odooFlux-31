PORT=8000
TOKEN_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Railway Postgres injects DATABASE_URL. Locally SQLite is used by default.
# Optional invoice email transport. Without SMTP_HOST, sends are recorded as simulated.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=billing@brightloop.example
SMTP_STARTTLS=true
SMTP_SSL=false
